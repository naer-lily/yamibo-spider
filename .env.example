# Yamibo Spider 配置
# 复制此文件为 .env 并填写

# AI 提供商配置
AI_PROVIDER=deepseek          # openai | deepseek | google | anthropic | openai_compat
AI_MODEL=deepseek-chat
AI_API_KEY=your-api-key-here
AI_BASE_URL=                  # 仅 openai_compat 需要

# 服务配置
POLL_INTERVAL=30              # 轮询间隔（分钟）
POLL_ENABLED=0                # 是否启用服务端轮询（1=是，0=否，默认关闭依赖 LNReader 刷新）
